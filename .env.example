# Server listening port
PORT=3000

# Runtime environment (development, production, or test)
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/one_for_all

# Secret key used to sign and verify JSON Web Tokens (min 32 characters)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Token expiration duration
JWT_EXPIRES_IN=8h

# Allowed origin for CORS and frontend client requests
CLIENT_ORIGIN=http://localhost:3000

# Cost factor for bcrypt password hashing
BCRYPT_ROUNDS=12

# Default user ID for initial seeded administrator account
SEED_ADMIN_ID=ADM0001

# Display name for initial seeded administrator account
SEED_ADMIN_NAME=System Admin

# Initial password for seeded administrator account
SEED_ADMIN_PASSWORD=replace-with-a-temporary-password

# Default initial password for seeded sample users
SEED_SAMPLE_PASSWORD=replace-with-a-temporary-password
